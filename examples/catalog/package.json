{
  "name": "@robomous/ui-core-docs",
  "private": true,
  "description": "The documentation site for @robomous/ui-core: one page per component with live demos, usage, composition and generated API tables. Imports the real package; owns docs and demos only.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/extract-api.ts",
    "build": "astro build",
    "check": "astro sync && astro check",
    "preview": "astro preview",
    "fresh": "astro dev stop && node -e \"fs.rmSync('node_modules/.vite',{recursive:true,force:true})\"",
    "api": "node scripts/extract-api.ts"
  },
  "dependencies": {
    "@robomous/ui-core": "workspace:*",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
