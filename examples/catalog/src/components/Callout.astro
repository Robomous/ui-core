---
interface Props {
  /** `note` adds context; `warning` marks a trap the reader will fall into. */
  tone?: "note" | "warning";
  title?: string;
}

const { tone = "note", title } = Astro.props;
const icon =
  tone === "warning"
    ? "M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"
    : "M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z";
---

<!-- A note sits in the text column on the page's own surface: a hairline and
     an icon say "aside" without a second background competing with demos. -->
<aside
  class="callout my-6 flex gap-3 rounded-md border px-4 py-3.5 text-sm leading-6"
  data-tone={tone}
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={["mt-1 size-4 shrink-0", tone === "warning" ? "text-warning" : "text-info"]}
  >
    <path d={icon}></path>
  </svg>
  <div class="flex min-w-0 flex-col gap-1 text-pretty text-muted-foreground">
    {title && <strong class="font-medium text-foreground">{title}</strong>}
    <div class="callout-body">
      <slot />
    </div>
  </div>
</aside>
