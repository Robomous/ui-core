---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<!-- The right lane mirrors the left one: the same label, the same item recipe
     and the same current-item surface, so the two rails read as one system.
     The left says where the page sits in the docs, this one where the reader
     sits in the page. -->
<nav aria-label="On this page" class="px-4 py-6 text-sm" data-toc>
  {items.length > 0 && (
    <>
      <p class="px-3 pb-2 text-[11px] font-medium tracking-[0.08em] text-muted-foreground uppercase">
        On this page
      </p>
      <ul class="flex flex-col">
        {items.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                "block rounded-md py-1.5 pr-3 text-pretty text-muted-foreground transition-colors hover:text-foreground aria-[current=location]:bg-muted aria-[current=location]:text-foreground",
                heading.depth === 3 ? "pl-6" : "pl-3",
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</nav>

<script>
  // The current section: the last heading that has scrolled past the header;
  // at the very bottom, the last one however short.
  for (const toc of document.querySelectorAll<HTMLElement>("[data-toc]")) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((element): element is HTMLElement => element !== null);
    if (targets.length === 0) continue;
    let frame = 0;
    const update = () => {
      frame = 0;
      const root = document.documentElement;
      const offset = 96;
      const atBottom = innerHeight + scrollY >= root.scrollHeight - 2;
      let index = atBottom ? targets.length - 1 : -1;
      if (!atBottom) {
        for (const [i, target] of targets.entries()) {
          if (target.getBoundingClientRect().top - offset <= 0) index = i;
          else break;
        }
      }
      const id = targets[Math.max(index, 0)]!.id;
      for (const link of links) {
        if (decodeURIComponent(link.hash.slice(1)) === id)
          link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    addEventListener("scroll", () => (frame ||= requestAnimationFrame(update)), { passive: true });
    addEventListener("resize", () => (frame ||= requestAnimationFrame(update)));
    update();
  }
</script>
