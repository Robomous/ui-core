---
import CodePanel from "@/components/CodePanel.astro";
import { demoSource } from "@/lib/demo-source";

interface Props {
  /** Path under src/demos/, without extension: "button/variants". */
  demo: string;
  align?: "center" | "start" | "stretch";
  class?: string;
}

const { demo, align = "center", class: className } = Astro.props;
const code = demoSource(demo);
const alignment = {
  center: "items-center justify-center",
  start: "items-start justify-start",
  stretch: "items-stretch justify-stretch",
}[align];
---

<figure
  class:list={["my-6 overflow-hidden rounded-xl ring-1 ring-foreground/10", className]}
  data-demo={demo}
>
  <!-- The height follows the demo; the floor only keeps a lone button from
       looking stranded. -->
  <div class:list={["flex min-h-40 flex-wrap gap-3 px-6 py-10 md:px-10 md:py-12", alignment]}>
    <slot />
  </div>
  <CodePanel code={code} />
</figure>
