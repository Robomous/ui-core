---
import { Code } from "astro:components";

import CopyButton from "@/components/CopyButton";

interface Props {
  code: string;
  lang?: "tsx" | "ts" | "bash" | "css" | "json" | "text";
  open?: boolean;
  label?: string;
  openLabel?: string;
}

const {
  code,
  lang = "tsx",
  open = false,
  label = "Show code",
  openLabel = "Hide code",
} = Astro.props;
---

<details class="group/code border-t" open={open}>
  <!-- One bar, a shade below the page, that says what the click will do. The
       chevron points at the code: to the right while it is folded, down once
       it is open. -->
  <summary class="flex cursor-pointer list-none items-center gap-2.5 bg-muted/40 px-4 py-2.5 text-sm transition-colors select-none hover:bg-muted/70 focus-visible:ring-2 focus-visible:ring-ring/30 focus-visible:ring-inset focus-visible:outline-none [&::-webkit-details-marker]:hidden">
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-3.5 text-muted-foreground transition-transform duration-150 ease-out group-open/code:rotate-90"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
    <span class="group-open/code:hidden">{label}</span>
    <span class="hidden group-open/code:inline">{openLabel}</span>
  </summary>
  <div class="code-lines relative border-t">
    <div class="absolute top-4 right-3">
      <CopyButton client:visible code={code} />
    </div>
    <Code
      code={code}
      lang={lang}
      themes={{ light: "github-light", dark: "github-dark" }}
      defaultColor={false}
      class="max-h-[32rem] overflow-auto py-4 pr-12 pl-3 text-[13px] leading-6"
    />
  </div>
</details>
