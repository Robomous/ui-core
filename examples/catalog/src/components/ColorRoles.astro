---
import SpecTable from "@/components/SpecTable.astro";

/**
 * One family of roles as a reference table: the swatch and the role, the
 * utility that paints it, and what it is for. Class strings stay literal so
 * Tailwind emits them.
 */
interface Props {
  set: "surfaces" | "emphasis" | "status" | "structure";
}

const SETS = {
  surfaces: [
    {
      role: "background",
      fill: "bg-background text-foreground",
      classes: "bg-background text-foreground",
      usage: "The page. Nothing sits beneath it.",
    },
    {
      role: "card",
      fill: "bg-card text-card-foreground",
      classes: "bg-card text-card-foreground",
      usage: "Content that sits in place: Card, Alert, Attachment.",
    },
    {
      role: "popover",
      fill: "bg-popover text-popover-foreground",
      classes: "bg-popover text-popover-foreground",
      usage: "Anything that floats and closes: menus, Select, Dialog, Sheet.",
    },
    {
      role: "muted",
      fill: "bg-muted text-muted-foreground",
      classes: "bg-muted text-muted-foreground",
      usage: "A recess, and the quieter ink: Kbd, a card's footer band, descriptions.",
    },
  ],
  emphasis: [
    {
      role: "primary",
      fill: "bg-primary text-primary-foreground",
      classes: "bg-primary text-primary-foreground",
      usage: "The one action that matters on a surface: the default Button, a checked control.",
    },
    {
      role: "secondary",
      fill: "bg-secondary text-secondary-foreground",
      classes: "bg-secondary text-secondary-foreground",
      usage: "A supporting action or chip: the secondary Button and Badge.",
    },
    {
      role: "accent",
      fill: "bg-accent text-accent-foreground",
      classes: "bg-accent text-accent-foreground",
      usage: "The highlighted row: a menu item under the pointer or the keyboard.",
    },
  ],
  status: [
    {
      role: "success",
      fill: "bg-success",
      classes: "bg-success · text-success",
      usage: "A solid mark, an icon or a run of inline text.",
    },
    {
      role: "success-surface",
      fill: "bg-success-surface text-success",
      classes: "bg-success-surface text-success",
      usage: "The soft chip or panel a status Badge or Alert wears.",
    },
    {
      role: "warning",
      fill: "bg-warning",
      classes: "bg-warning · text-warning",
      usage: "Amber: something needs attention before it goes wrong.",
    },
    {
      role: "warning-surface",
      fill: "bg-warning-surface text-warning",
      classes: "bg-warning-surface text-warning",
      usage: "Its soft surface.",
    },
    {
      role: "info",
      fill: "bg-info",
      classes: "bg-info · text-info",
      usage: "Blue: neutral information, announced politely.",
    },
    {
      role: "info-surface",
      fill: "bg-info-surface text-info",
      classes: "bg-info-surface text-info",
      usage: "Its soft surface.",
    },
    {
      role: "destructive",
      fill: "bg-destructive text-destructive-foreground",
      classes: "bg-destructive · text-destructive",
      usage: "Red: a failure, or an action that cannot be undone.",
    },
    {
      role: "destructive tint",
      fill: "bg-destructive/10 text-destructive dark:bg-destructive/20",
      classes: "bg-destructive/10 dark:bg-destructive/20",
      usage: "No surface role of its own: the tint is the ink at low alpha.",
    },
  ],
  structure: [
    {
      role: "border",
      fill: "bg-border",
      classes: "border-border",
      usage: "Every hairline. The base layer applies it to every element.",
    },
    {
      role: "input",
      fill: "bg-input",
      classes: "border-input bg-input/20",
      usage: "A control's edge and, at low alpha, its fill.",
    },
    {
      role: "ring",
      fill: "bg-ring",
      classes: "ring-ring/30 border-ring",
      usage: "The focus ring's colour. Each component owns its geometry.",
    },
    {
      role: "overlay",
      fill: "bg-overlay",
      classes: "bg-overlay",
      usage: "The scrim behind a Dialog, Sheet or Drawer.",
    },
  ],
} as const;

const rows = SETS[Astro.props.set];
---

<SpecTable example="Role">
  {rows.map((row) => (
    <div class="spec-row">
      <span class="flex items-center gap-3">
        <span
          class:list={[
            "size-6 shrink-0 rounded-full ring-1 ring-foreground/10 ring-inset",
            row.fill,
          ]}
        ></span>
        <span class="font-medium">{row.role}</span>
      </span>
      <code class="font-mono text-xs text-muted-foreground">{row.classes}</code>
      <span class="text-muted-foreground">{row.usage}</span>
    </div>
  ))}
</SpecTable>
