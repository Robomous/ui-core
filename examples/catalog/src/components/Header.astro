---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
  buttonVariants,
} from "@robomous/ui-core";
import { HouseIcon } from "@robomous/ui-core/icons";

import MobileNav from "@/components/MobileNav";
import SearchCommand from "@/components/SearchCommand";
import ThemeToggle from "@/components/ThemeToggle";
import type { Crumb, Nav } from "@/lib/nav";
import { SITE } from "@/lib/site";

interface Props {
  nav: Nav;
  current: string;
  crumbs: Crumb[];
}

const { nav, current, crumbs } = Astro.props;
---

<!-- The header shares the page's two columns: the wordmark sits over the
     navigation; over the content, where the page sits on the left, then the
     search and the controls on the right. It wears the frame's tone, and its
     parts are cells divided by full-height hairlines, the same rules that
     divide the page below. -->
<header class="sticky top-0 z-40 flex h-16 border-b bg-(--frame)/90 backdrop-blur-sm md:grid md:grid-cols-[16rem_minmax(0,1fr)]">
  <div class="flex items-center gap-2 pr-2 pl-4 md:border-r md:px-5">
    <MobileNav client:load nav={nav} current={current} />
    <a href="/" class="flex items-center gap-2.5 text-sm font-medium">
      <!-- Robomous orange is identity only: the wordmark is the one place it paints. -->
      <span aria-hidden="true" class="size-4 rounded-[5px] bg-(--brand)"></span>
      {SITE.short}
    </a>
  </div>
  <div class="flex min-w-0 flex-1 items-stretch">
    <!-- The page's place in the docs. The separator is a slash, the way a
         path reads, and only the last crumb is in the foreground. -->
    <Breadcrumb className="hidden min-w-0 flex-1 items-center px-10 md:flex">
      <BreadcrumbList className="flex-nowrap gap-2 text-sm">
        <BreadcrumbItem>
          <BreadcrumbLink
            href="/"
            aria-label="Home"
            className="flex items-center hover:no-underline"
          >
            <HouseIcon className="size-4" strokeWidth={1.75} />
          </BreadcrumbLink>
        </BreadcrumbItem>
        {crumbs.map((crumb, index) => (
          <>
            <BreadcrumbSeparator className="w-auto text-muted-foreground/50">/</BreadcrumbSeparator>
            <BreadcrumbItem className="min-w-0">
              {index === crumbs.length - 1 ? (
                <BreadcrumbPage className="truncate">{crumb.label}</BreadcrumbPage>
              ) : crumb.href ? (
                <BreadcrumbLink href={crumb.href} className="truncate hover:no-underline">
                  {crumb.label}
                </BreadcrumbLink>
              ) : (
                <span class="truncate">{crumb.label}</span>
              )}
            </BreadcrumbItem>
          </>
        ))}
      </BreadcrumbList>
    </Breadcrumb>
    <div class="ml-auto flex items-center px-3 sm:border-l sm:px-4">
      <SearchCommand client:idle />
    </div>
    <div class="flex items-center gap-1 border-l px-3">
      <a
        href={SITE.repo}
        class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
        aria-label="GitHub repository"
        target="_blank"
        rel="noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="size-4">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
