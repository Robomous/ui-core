---
import { buttonVariants, cn } from "@robomous/ui-core";

import MobileNav from "@/components/MobileNav";
import SearchCommand from "@/components/SearchCommand";
import ThemeToggle from "@/components/ThemeToggle";
import type { Nav } from "@/lib/nav";
import { SITE } from "@/lib/site";

interface Props {
  nav: Nav;
  current: string;
}

const { nav, current } = Astro.props;

const links = [
  { title: "Home", href: "/", match: (path: string) => path === "/" },
  { title: "Docs", href: "/docs/introduction", match: (path: string) => path.startsWith("/docs") },
  {
    title: "Components",
    href: "/components",
    match: (path: string) => path.startsWith("/components"),
  },
];
---

<header class="sticky top-0 z-40 border-b bg-background/90 backdrop-blur-sm">
  <div class="mx-auto flex h-14 w-full max-w-[90rem] items-center gap-2 px-4 md:px-6">
    <MobileNav client:load nav={nav} current={current} />
    <a href="/" class="mr-2 font-heading text-sm font-medium">
      {SITE.short}
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.match(current) ? "page" : undefined}
          class={cn(
            buttonVariants({ variant: "ghost", size: "sm" }),
            "text-muted-foreground aria-[current=page]:text-foreground",
          )}
        >
          {link.title}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <SearchCommand client:idle />
      <a
        href={SITE.repo}
        class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
        aria-label="GitHub repository"
        target="_blank"
        rel="noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="size-4">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
