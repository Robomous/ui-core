---
import InlineText from "@/components/InlineText.astro";

/** A page's description as prose; frontmatter is plain text with backtick code. */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="text-base/relaxed text-pretty text-muted-foreground md:text-lg/relaxed">
  <InlineText text={text} />
</p>
