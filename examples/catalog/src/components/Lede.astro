---
/**
 * A page's description as prose. Frontmatter is plain text, so `code` spans
 * are written with backticks; this renders them as <code> and leaves the rest.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
const parts = text.split("`");
---

<p class="text-lg text-muted-foreground">
  {parts.map((part, index) =>
    index % 2 === 1 ? (
      <code class="rounded-md bg-muted px-1.5 py-0.5 font-mono text-[0.85em]">{part}</code>
    ) : (
      part
    ),
  )}
</p>
