---
import Docs from "@/layouts/Docs.astro";
import { buildNav } from "@/lib/nav";

const { groups } = await buildNav();
const toc = groups.map((group) => ({
  depth: 2,
  slug: group.label.toLowerCase().replaceAll(/[^a-z]+/g, "-"),
  text: group.label,
}));
---

<Docs
  title="Components"
  description="Forty-five owned components over Radix, Base UI, cmdk and vaul behaviour."
  headings={toc}
>
  <header class="mb-12 flex flex-col gap-3">
    <h1 class="text-3xl font-medium tracking-tight md:text-4xl">Components</h1>
    <p class="text-lg/relaxed text-pretty text-muted-foreground">
      Forty-five owned components over Radix, Base UI, cmdk and vaul behaviour. Anatomy is composed
      at the call site; geometry and colour are the component's.
    </p>
  </header>
  <div class="flex flex-col gap-12">
    {groups.map((group, index) => (
      <section aria-labelledby={toc[index]!.slug} class="flex flex-col gap-4">
        <h2
          id={toc[index]!.slug}
          class="flex scroll-mt-20 items-baseline gap-2 text-base font-medium"
        >
          {group.label}
          <span class="text-sm font-normal text-muted-foreground tabular-nums">
            {group.links.length}
          </span>
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {group.links.map((component) => (
            <li>
              <a
                href={component.href}
                class="flex h-full flex-col gap-1 rounded-xl bg-card p-4 ring-1 ring-foreground/10 transition-colors hover:bg-muted/60 focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
              >
                <span class="font-medium">{component.title}</span>
                <span class="line-clamp-2 text-sm text-pretty text-muted-foreground">
                  {component.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Docs>
