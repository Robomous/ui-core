---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";

import ApiReference from "@/components/ApiReference";
import BuiltOn from "@/components/BuiltOn";
import Lede from "@/components/Lede.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import Preview from "@/components/Preview.astro";
import Docs from "@/layouts/Docs.astro";
import { componentApi } from "@/lib/api";
import { groupFor, plain } from "@/lib/nav";

export async function getStaticPaths() {
  const entries = await getCollection("components");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"components">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const api = componentApi(entry.id);
const group = groupFor(entry.id);
const toc = [...headings, { depth: 2, slug: "api-reference", text: "API Reference" }];
---

<Docs title={entry.data.title} description={plain(entry.data.description)} headings={toc}>
  <header class="mb-8 flex flex-col gap-3">
    {group ? (
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
        <a href="/components" class="transition-colors hover:text-foreground">
          Components
        </a>
        <span aria-hidden="true" class="px-1.5">
          /
        </span>
        {group}
      </p>
    ) : null}
    <h1 class="text-3xl font-medium tracking-tight text-balance md:text-4xl">{entry.data.title}</h1>
    <Lede text={entry.data.description} />
  </header>
  <BuiltOn builtOn={entry.data.builtOn} />
  <div class="docs-prose">
    <Content components={{ Preview, pre: CodeBlock }} />
    <h2 id="api-reference">API Reference</h2>
  </div>
  <ApiReference api={api} />
</Docs>
