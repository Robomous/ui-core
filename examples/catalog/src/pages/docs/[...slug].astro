---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";

import Lede from "@/components/Lede.astro";
import Preview from "@/components/Preview.astro";
import Docs from "@/layouts/Docs.astro";
import { plain } from "@/lib/nav";

export async function getStaticPaths() {
  const entries = await getCollection("sections");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"sections">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs title={entry.data.title} description={plain(entry.data.description)} headings={headings}>
  <header class="mb-8 flex flex-col gap-2">
    <h1 class="text-3xl font-medium tracking-tight">{entry.data.title}</h1>
    <Lede text={entry.data.description} />
  </header>
  <div class="docs-prose">
    <Content components={{ Preview }} />
  </div>
</Docs>
