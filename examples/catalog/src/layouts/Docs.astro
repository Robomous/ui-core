---
import type { MarkdownHeading } from "astro";

import Header from "@/components/Header.astro";
import DocsSidebar from "@/components/DocsSidebar";
import PrevNext from "@/components/PrevNext";
import Toc from "@/components/Toc.astro";
import Base from "@/layouts/Base.astro";
import { buildNav, neighbours, normalise } from "@/lib/nav";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;
const nav = await buildNav();
const current = normalise(Astro.url.pathname);
const { prev, next } = neighbours(nav, current);
---

<Base title={title} description={description}>
  <Header nav={nav} current={current} />
  <!-- Three lanes: navigation, the page, and where you are on it. The page
       column keeps a reading measure and centres in whatever room is left, so
       the rails never push the prose off its line length. -->
  <div class="mx-auto grid w-full max-w-[90rem] md:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_14rem]">
    <aside class="sticky top-14 no-scrollbar hidden h-[calc(100svh-3.5rem)] overflow-y-auto border-r px-3 md:block">
      <DocsSidebar client:load nav={nav} current={current} />
    </aside>
    <main class="min-w-0 px-4 pt-8 pb-16 sm:px-8 md:pt-12 lg:px-12">
      <article class="mx-auto max-w-3xl">
        <slot />
      </article>
      <div class="mx-auto mt-20 max-w-3xl">
        <PrevNext prev={prev} next={next} />
      </div>
    </main>
    <aside class="sticky top-14 hidden h-[calc(100svh-3.5rem)] py-12 pr-6 xl:block">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>
