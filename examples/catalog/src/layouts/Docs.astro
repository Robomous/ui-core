---
import type { MarkdownHeading } from "astro";

import Header from "@/components/Header.astro";
import DocsSidebar from "@/components/DocsSidebar";
import PrevNext from "@/components/PrevNext";
import Toc from "@/components/Toc.astro";
import Base from "@/layouts/Base.astro";
import { buildNav, neighbours, normalise } from "@/lib/nav";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;
const nav = await buildNav();
const current = normalise(Astro.url.pathname);
const { prev, next } = neighbours(nav, current);
---

<Base title={title} description={description}>
  <Header nav={nav} current={current} />
  <div class="mx-auto flex w-full max-w-[90rem] px-4 md:px-6">
    <aside class="sticky top-14 no-scrollbar hidden h-[calc(100svh-3.5rem)] w-56 shrink-0 overflow-y-auto md:block">
      <DocsSidebar client:load nav={nav} current={current} />
    </aside>
    <main class="min-w-0 flex-1 py-10 md:px-10 lg:px-16">
      <article class="mx-auto max-w-3xl">
        <slot />
      </article>
      <div class="mx-auto mt-16 max-w-3xl">
        <PrevNext prev={prev} next={next} />
      </div>
    </main>
    <aside class="sticky top-14 hidden h-[calc(100svh-3.5rem)] w-52 shrink-0 py-10 xl:block">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>
