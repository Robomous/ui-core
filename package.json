{
  "name": "@robomous/ui-core",
  "version": "0.4.0",
  "description": "Robomous design system, built on top of shadcn/ui: owned React components over Radix, Base UI, cmdk and vaul, and the one stylesheet they resolve through.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Robomous/ui-core.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./src/theme/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm docs:check && pnpm test:package",
    "docs:dev": "pnpm --filter @robomous/ui-core-docs fresh && pnpm build && pnpm --filter @robomous/ui-core-docs dev",
    "docs:check": "pnpm --filter @robomous/ui-core-docs api && pnpm --filter @robomous/ui-core-docs check && pnpm --filter @robomous/ui-core-docs build",
    "test": "vitest run --project unit",
    "test:package": "vitest run --project package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
